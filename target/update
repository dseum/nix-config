#!/usr/bin/env bash

set -euo pipefail

GREEN=
RED=
if [[ -z ${NO_COLOR:-} && -t 1 ]]; then
  GREEN=$(printf '\033[1;32m')
fi
if [[ -z ${NO_COLOR:-} && -t 2 ]]; then
  RED=$(printf '\033[1;31m')
fi

println() {
  if [[ -n $1 ]]; then
    printf 'nix-config: %s%s\033[0m\n' "$1" "$2"
  else
    printf 'nix-config: %s\n' "$2"
  fi
}

FLAKE_DIR=$(realpath "$1")
CONFIGURATION=$2
shift 2
cd "$FLAKE_DIR"

PACKAGE_NAMES=()
declare -A PACKAGE_UPDATERS=()

while [[ $1 != -- ]]; do
  PACKAGE_NAME=$1
  PACKAGE_UPDATER=$2
  shift 2

  PACKAGE_NAMES+=("$PACKAGE_NAME")
  PACKAGE_UPDATERS["$PACKAGE_NAME"]=$PACKAGE_UPDATER
done
shift

SELECTED_PACKAGES=()
FLAKE_INPUTS=()
UPDATE_FLAKE=false

case "${1-}" in
"")
  SELECTED_PACKAGES=("${PACKAGE_NAMES[@]}")
  UPDATE_FLAKE=true
  ;;
-h | --help)
  printf 'usage: nix run .#update [-- package [NAME...] | input [NAME...]]\n'
  if (( ${#PACKAGE_NAMES[@]} == 0 )); then
    printf 'updatable packages: none\n'
  else
    printf 'updatable packages: %s\n' "${PACKAGE_NAMES[*]}"
  fi
  exit 0
  ;;
package)
  shift
  if (( $# == 0 )); then
    SELECTED_PACKAGES=("${PACKAGE_NAMES[@]}")
  else
    for PACKAGE_NAME in "$@"; do
      if [[ ! -v "PACKAGE_UPDATERS[$PACKAGE_NAME]" ]]; then
        println "$RED" "package $PACKAGE_NAME has no update script" >&2
        exit 2
      fi
      SELECTED_PACKAGES+=("$PACKAGE_NAME")
    done
  fi
  ;;
input)
  shift
  FLAKE_INPUTS=("$@")
  UPDATE_FLAKE=true
  ;;
*)
  println "$RED" "expected package or input, got $1" >&2
  exit 2
  ;;
esac

if (( ${#SELECTED_PACKAGES[@]} == 0 )) && [[ $UPDATE_FLAKE == false ]]; then
  println "" "no local packages configured for updates"
  exit 0
fi

for PACKAGE_NAME in "${SELECTED_PACKAGES[@]}"; do
  println "" "$PACKAGE_NAME: checking for updates..."
  "${PACKAGE_UPDATERS[$PACKAGE_NAME]}"
done

if [[ $UPDATE_FLAKE == false ]]; then
  exit 0
fi

PREVIEW_DIR=$(realpath "$(mktemp -d)")
ORIGINAL_LOCK="$PREVIEW_DIR/original.lock"
CANDIDATE_LOCK="$PREVIEW_DIR/flake.lock"
REPLACEMENT_LOCK=

cleanup() {
  if [[ -e $ORIGINAL_LOCK ]]; then
    unlink "$ORIGINAL_LOCK" || true
  fi
  if [[ -e $CANDIDATE_LOCK ]]; then
    unlink "$CANDIDATE_LOCK" || true
  fi
  if [[ -n $REPLACEMENT_LOCK && -e $REPLACEMENT_LOCK ]]; then
    unlink "$REPLACEMENT_LOCK" || true
  fi
  rmdir "$PREVIEW_DIR" 2>/dev/null || true
}
trap cleanup EXIT

cp "$FLAKE_DIR/flake.lock" "$ORIGINAL_LOCK"

println "" "flake inputs: checking for updates..."

nix --extra-experimental-features 'nix-command flakes' flake update \
  --flake "path:${FLAKE_DIR}" \
  --reference-lock-file "$ORIGINAL_LOCK" \
  --output-lock-file "$CANDIDATE_LOCK" \
  "${FLAKE_INPUTS[@]}"

if cmp -s "$ORIGINAL_LOCK" "$CANDIDATE_LOCK"; then
  println "$GREEN" "flake inputs: up to date"
  exit 0
fi

INPUT_CHANGES=$(jq -r -s '
  def display_reference:
    if . == null then "∅"
    elif .locked.rev? then .locked.rev[:12]
    elif .locked.narHash? then .locked.narHash[:24]
    elif .locked.path? then .locked.path
    else "unknown" end;

  (.[0].nodes // {}) as $before |
  (.[1].nodes // {}) as $after |
  (($before | keys) + ($after | keys) | unique[]) as $name |
  select($name != "root" and $before[$name] != $after[$name]) |
  ($before[$name] | display_reference) as $old |
  ($after[$name] | display_reference) as $new |
  if $before[$name] == null then
    "\($name): added"
  elif $after[$name] == null then
    "\($name): removed"
  elif $old != $new then
    "\($name): \($old) → \($new)"
  elif $before[$name].locked.narHash != $after[$name].locked.narHash then
    "\($name): content hash changed"
  elif $before[$name].inputs != $after[$name].inputs then
    "\($name): dependencies changed"
  else
    "\($name): lock metadata changed"
  end
' "$ORIGINAL_LOCK" "$CANDIDATE_LOCK")

if [[ -n $INPUT_CHANGES ]]; then
  println "" "flake input changes:"
  while IFS= read -r CHANGE; do
    printf '  %s\n' "$CHANGE"
  done <<< "$INPUT_CHANGES"
else
  println "" "flake.lock changed; no input revisions changed"
fi

println "" "evaluating system changes..."

BEFORE=$(nix --extra-experimental-features 'nix-command flakes' eval \
  --no-update-lock-file \
  --raw \
  --reference-lock-file "$ORIGINAL_LOCK" \
  "path:${FLAKE_DIR}#${CONFIGURATION}.drvPath")

AFTER=$(nix --extra-experimental-features 'nix-command flakes' eval \
  --no-update-lock-file \
  --raw \
  --reference-lock-file "$CANDIDATE_LOCK" \
  "path:${FLAKE_DIR}#${CONFIGURATION}.drvPath")

if [[ $BEFORE == "$AFTER" ]]; then
  println "" "system derivation unchanged"
else
  PACKAGE_CHANGES=$(nix --extra-experimental-features 'nix-command flakes' store diff-closures "$BEFORE" "$AFTER")
  if [[ -n $PACKAGE_CHANGES ]]; then
    println "" "package changes:"
    while IFS= read -r CHANGE; do
      printf '  %s\n' "$CHANGE"
    done <<< "$PACKAGE_CHANGES"
  else
    println "" "system derivation changed; no package differences reported"
  fi
fi

printf 'nix-config: update flake.lock? [Y/n] '
if ! IFS= read -r RESPONSE; then
  RESPONSE=
  printf '\n'
elif [[ ! -t 0 ]]; then
  printf '\n'
fi

case "$RESPONSE" in
"" | [yY] | [yY][eE][sS])
  if ! cmp -s "$ORIGINAL_LOCK" "$FLAKE_DIR/flake.lock"; then
    println "$RED" "flake.lock changed during the update; leaving it unchanged"
    exit 1
  fi

  REPLACEMENT_LOCK=$(mktemp "$FLAKE_DIR/.flake.lock.XXXXXX")
  cp "$CANDIDATE_LOCK" "$REPLACEMENT_LOCK"
  chmod 0644 "$REPLACEMENT_LOCK"
  mv "$REPLACEMENT_LOCK" "$FLAKE_DIR/flake.lock"
  REPLACEMENT_LOCK=
  println "$GREEN" "updated flake.lock"
  ;;
*)
  println "" "left flake.lock unchanged"
  ;;
esac
