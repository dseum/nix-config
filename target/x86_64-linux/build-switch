#!/bin/sh -e

GREEN=
RED=
if [ -z "${NO_COLOR:-}" ] && [ -t 1 ]; then
  GREEN=$(printf '\033[1;32m')
fi
if [ -z "${NO_COLOR:-}" ] && [ -t 2 ]; then
  RED=$(printf '\033[1;31m')
fi

println() {
  if [ -n "$1" ]; then
    printf 'nix-config: %s%s\033[0m\n' "$1" "$2"
  else
    printf 'nix-config: %s\n' "$2"
  fi
}

CPU=$(uname -m)

case "$CPU" in
x86_64)
  TARGET="x86_64-linux"
  ;;
aarch64)
  TARGET="aarch64-linux"
  ;;
*)
  println "${RED}" "unsupported architecture: ${CPU}" >&2
  exit 1
  ;;
esac

FLAKE_DIR=$(realpath "/etc/nixos")
HARDWARE_CONFIG=$(mktemp /etc/nixos/.hardware-configuration.nix.XXXXXX)
trap 'rm -f "$HARDWARE_CONFIG"' EXIT

println "" "target: ${TARGET}"

println "" "updating hardware-configuration.nix..."

sudo nixos-generate-config --show-hardware-config >"$HARDWARE_CONFIG"
chmod 0644 "$HARDWARE_CONFIG"
mv "$HARDWARE_CONFIG" /etc/nixos/hardware-configuration.nix

if [ -f /etc/nixos/hardware.nix ]; then
  println "" "using /etc/nixos/hardware.nix"
else
  cp "/etc/nixos/target/$TARGET/hardware.nix" /etc/nixos
  println "" "created /etc/nixos/hardware.nix"
fi

println "" "building and switching system..."

sudo -i /run/current-system/sw/bin/nixos-rebuild switch --flake "path:${FLAKE_DIR}#${TARGET}" "$@"

println "${GREEN}" "system switched"
